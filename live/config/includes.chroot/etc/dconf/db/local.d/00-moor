[org/gnome/shell]
enabled-extensions=['user-theme@gnome-shell-extensions.gcampax.github.com', 'dash-to-dock@micxgx.gmail.com']
favorite-apps=['moor.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.Console.desktop', 'chromium.desktop', 'org.gnome.Settings.desktop']
welcome-dialog-last-shown-version='999'
disable-user-extensions=false

[org/gnome/shell/extensions/user-theme]
name='WhiteSur-Dark-solid'

[org/gnome/shell/extensions/dash-to-dock]
dock-position='BOTTOM'
extend-height=false
dock-fixed=true
intellihide=false
dash-max-icon-size=48
show-trash=false
show-mounts=false
show-show-apps-button=true
apply-custom-theme=false
custom-theme-shrink=true
transparency-mode='FIXED'
background-opacity=0.9
click-action='minimize-or-previews'
hot-keys=false
disable-overview-on-startup=true

[org/gnome/desktop/interface]
gtk-theme='WhiteSur-Dark-solid'
icon-theme='WhiteSur-dark'
cursor-theme='WhiteSur-cursors'
color-scheme='prefer-dark'
clock-show-weekday=true
enable-animations=false

[org/gnome/desktop/wm/preferences]
button-layout='close,minimize,maximize:'

[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/moor/fjord.jpg'
picture-uri-dark='file:///usr/share/backgrounds/moor/fjord.jpg'
picture-options='zoom'

[org/gnome/desktop/screensaver]
picture-uri='file:///usr/share/backgrounds/moor/fjord.jpg'
lock-enabled=false

[org/gnome/desktop/session]
idle-delay=uint32 0

[org/gnome/desktop/search-providers]
disable-external=true
disabled=['org.gnome.Calendar.desktop', 'org.gnome.Contacts.desktop', 'org.gnome.Software.desktop']

[org/gnome/desktop/privacy]
remember-recent-files=false
recent-files-max-age=1
report-technical-problems=false

[org/gnome/system/location]
enabled=false

[org/gnome/settings-daemon/plugins/power]
idle-dim=false
sleep-inactive-ac-type='nothing'
sleep-inactive-battery-type='nothing'

[org/gnome/settings-daemon/plugins/color]
active=false

[org/gnome/settings-daemon/plugins/print-notifications]
active=false

[org/gnome/settings-daemon/plugins/sharing]
active=false

[org/gnome/settings-daemon/plugins/smartcard]
active=false

[org/gnome/settings-daemon/plugins/wacom]
active=false

[org/freedesktop/tracker/miner/files]
crawling-interval=-2
enable-monitors=false
index-recursive-directories=@as []
index-single-directories=@as []

[org/gnome/software]
download-updates=false
allow-updates=false
